2026-05-05 22:28:46.901 INFO  - OUTPUT {"candidate_techniques":[{"technique_id":"T0820","technique_title":"Lateral Tool Transfer","technique_description":"Adversaries may transfer tools or other files between systems in a network to accomplish lateral movement and/or to stage adversary tools for use on a target. Lateral tool transfer typically occurs through existing command and control channels but may also occur through alternate protocols such as SMB.","mapped_categories":["Preventative","Detective"]},{"technique_id":"T0886","technique_title":"Remote Services","technique_description":"Adversaries may use legitimate external-facing remote services to move between assets. These services allow users to interact with hosts remotely across network infrastructure.","mapped_categories":["Preventative","Detective"]},{"technique_id":"T0890","technique_title":"Exploitation of Remote Services","technique_description":"Adversaries may exploit a weakness in an internet-facing computer or program to initially access a network.","mapped_categories":["Preventative","Detective"]},{"technique_id":"T0869","technique_title":"Data Obfuscation","technique_description":"Adversaries may obfuscate command and control traffic to make it difficult to detect. This can include encryption, encoding, or other methods to obscure network traffic patterns.","mapped_categories":["Detective"]},{"technique_id":"T0884","technique_title":"Spearphishing Link","technique_description":"Adversaries may send spearphishing emails with malicious links to move laterally within a network or establish initial access.","mapped_categories":["Preventative","Detective"]},{"technique_id":"T0885","technique_title":"Traitor","technique_description":"Adversaries may leverage legitimate administrative interfaces or user accounts to establish persistence in a target environment.","mapped_categories":["Preventative"]},{"technique_id":"T0866","technique_title":"Exploitation","technique_description":"Adversaries may exploit unpatched or outdated software to gain unauthorized access to systems.","mapped_categories":["Preventative","Detective"]},{"technique_id":"T0876","technique_title":"Dial Out","technique_description":"Adversaries may use devices that are able to make outbound connections to transfer data or establish command and control channels.","mapped_categories":["Preventative","Detective"]},{"technique_id":"T0877","technique_title":"Exfiltration","technique_description":"Adversaries may transfer data out of an ICS network to accomplish their objectives.","mapped_categories":["Preventative","Detective","Containment"]}]}
